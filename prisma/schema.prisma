// Chog World Order — Passport data model.
//
// Design rules enforced by the schema:
// - One account per wallet address (User.address is unique, stored lowercase).
// - Session tokens are never stored in plain text (WalletSession.tokenHash).
// - The same piece of evidence can only be claimed once, by anyone
//   (Evidence.dedupeKey is unique), so duplicates can never produce extra stamps.
// - A user holds at most one stamp per category, and a single evidence record
//   can back at most one stamp of each category.
// - Reputation is an append-only ledger (ReputationEvent). Every event has a
//   unique dedupeKey; wrong events are reversed (at most once), never edited
//   or deleted. Scores are the sum of the ledger and can be recomputed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CONTRIBUTOR
  REVIEWER
  ADMIN
}

enum EvidenceKind {
  ONCHAIN_INTERACTION
  COMMUNITY_CONTRIBUTION
  CODE_CONTRIBUTION
  RESEARCH_CONTRIBUTION
  CAMPAIGN_DELIVERABLE
}

enum VerificationMethod {
  ONCHAIN_RECEIPT
  REVIEWER_APPROVAL
  MAINTAINER_APPROVAL
  CAMPAIGN_ACCEPTANCE
}

enum EvidenceStatus {
  PENDING
  VERIFIED
  REJECTED
  UNAVAILABLE
}

enum StampCategory {
  MONAD_EXPLORER
  COMMUNITY_CONTRIBUTOR
  BUILDER
  RESEARCHER
  COLLABORATOR
  CONSISTENT_CONTRIBUTOR
}

enum ReputationEventKind {
  CONTRIBUTION
  CONSISTENCY_BONUS
  ADJUSTMENT
  REVERSAL
}

enum SnapshotCause {
  VERIFICATION
  RECALCULATION
  ADJUSTMENT
}

model User {
  id          String   @id @default(cuid())
  /// Lowercase 0x-prefixed wallet address.
  address     String   @unique
  displayName String?
  role        UserRole @default(CONTRIBUTOR)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions           WalletSession[]
  evidence           Evidence[]           @relation("EvidenceOwner")
  reviewedEvidence   Evidence[]           @relation("EvidenceReviewer")
  stamps             PassportStamp[]      @relation("StampHolder")
  issuedStamps       PassportStamp[]      @relation("StampIssuer")
  reputationEvents   ReputationEvent[]    @relation("ReputationHolder")
  reputationActions  ReputationEvent[]    @relation("ReputationActor")
  snapshots          ReputationSnapshot[] @relation("SnapshotHolder")
  triggeredSnapshots ReputationSnapshot[] @relation("SnapshotTrigger")
}

/// A wallet sign-in (SIWE). The cookie holds a random token; only its SHA-256 hash is stored.
model WalletSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  /// SIWE nonce used for this sign-in. Unique, so a signed message cannot be replayed.
  nonce      String    @unique
  chainId    Int
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Evidence {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation("EvidenceOwner", fields: [userId], references: [id], onDelete: Cascade)
  kind               EvidenceKind
  /// Reputation category ("campaign", "protocol", "content", "research", "code").
  category           String
  verificationMethod VerificationMethod
  status             EvidenceStatus     @default(PENDING)
  title              String
  summary            String
  /// Public pointer to the evidence: a transaction hash, PR URL, document URL, or deliverable id.
  reference          String
  /// Canonical form of the reference. Unique across all users to block duplicate claims.
  dedupeKey          String             @unique
  chainId            Int?
  txHash             String?
  /// Supported application id (on-chain evidence only).
  appId              String?
  /// When the activity happened (block time for on-chain evidence).
  occurredAt         DateTime
  /// Short reason shown to the contributor and the public.
  statusReason       String?
  /// What the verifier checked (block number, app id, event name, reviewer decision...). Public.
  verificationData   Json?
  /// Reviewer-only note. Never returned by public APIs.
  reviewerNote       String?
  reviewerId         String?
  reviewer           User?              @relation("EvidenceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  stamps           PassportStamp[]
  reputationEvents ReputationEvent[]

  @@index([userId, status])
  @@index([category, status])
  @@index([status, createdAt])
  @@index([kind, status])
}

model PassportStamp {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation("StampHolder", fields: [userId], references: [id], onDelete: Cascade)
  category   StampCategory
  /// The verified evidence that earned this stamp.
  evidenceId String
  evidence   Evidence      @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  issuedAt   DateTime      @default(now())
  /// Reviewer or admin who triggered issuance. Null when issued automatically after on-chain verification.
  issuedById String?
  issuedBy   User?         @relation("StampIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([userId, category])
  @@unique([evidenceId, category])
  @@index([userId, issuedAt])
}

model ReputationEvent {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation("ReputationHolder", fields: [userId], references: [id], onDelete: Cascade)
  kind               ReputationEventKind
  /// Points awarded (negative for reversals and downward corrections). Always computed on the server.
  points             Int
  /// Score category, e.g. "code", "consistency", "adjustment". Matches the public breakdown.
  category           String
  /// Human-readable explanation shown in the public score history.
  reason             String
  /// Logical key from the rules engine (e.g. "contribution:<evidenceId>"). Null for adjustments and reversals.
  planKey            String?
  /// Physical idempotency key. Unique, so the same event can never be written twice.
  dedupeKey          String              @unique
  /// Version of the scoring rules that produced this event.
  calculationVersion String
  evidenceId         String?
  evidence           Evidence?           @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  /// Day ("2026-10-09") or ISO week ("2026-W41") the event counts toward.
  periodKey          String?
  /// For reversals: the event being reversed. Unique, so an event is reversed at most once.
  reversesEventId    String?             @unique
  reverses           ReputationEvent?    @relation("Reversal", fields: [reversesEventId], references: [id], onDelete: Restrict)
  reversedBy         ReputationEvent?    @relation("Reversal")
  /// Who made an adjustment or triggered a recalculation. Null for automatic events.
  actorId            String?
  actor              User?               @relation("ReputationActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([userId, category])
  @@index([planKey])
}

/// Score after each change, for history and fast reads. Always derivable from the ledger.
model ReputationSnapshot {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation("SnapshotHolder", fields: [userId], references: [id], onDelete: Cascade)
  total              Int
  /// Points per category at this moment.
  breakdown          Json
  tier               String
  calculationVersion String
  cause              SnapshotCause
  eventCount         Int
  triggeredById      String?
  triggeredBy        User?         @relation("SnapshotTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())

  @@index([userId, createdAt])
}
