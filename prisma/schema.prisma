// Chog World Order — Passport data model.
//
// Design rules enforced by the schema:
// - One account per wallet address (User.address is unique, stored lowercase).
// - Session tokens are never stored in plain text (WalletSession.tokenHash).
// - The same piece of evidence can only be claimed once, by anyone
//   (Evidence.dedupeKey is unique), so duplicates can never produce extra stamps.
// - A user holds at most one stamp per category, and a single evidence record
//   can back at most one stamp of each category.
// - Reputation is an append-only ledger (ReputationEvent). Every event has a
//   unique dedupeKey; wrong events are reversed (at most once), never edited
//   or deleted. Scores are the sum of the ledger and can be recomputed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CONTRIBUTOR
  REVIEWER
  ADMIN
}

enum EvidenceKind {
  ONCHAIN_INTERACTION
  COMMUNITY_CONTRIBUTION
  CODE_CONTRIBUTION
  RESEARCH_CONTRIBUTION
  CAMPAIGN_DELIVERABLE
}

enum VerificationMethod {
  ONCHAIN_RECEIPT
  REVIEWER_APPROVAL
  MAINTAINER_APPROVAL
  CAMPAIGN_ACCEPTANCE
}

enum EvidenceStatus {
  PENDING
  VERIFIED
  REJECTED
  UNAVAILABLE
}

enum StampCategory {
  MONAD_EXPLORER
  COMMUNITY_CONTRIBUTOR
  BUILDER
  RESEARCHER
  COLLABORATOR
  CONSISTENT_CONTRIBUTOR
}

enum ReputationEventKind {
  CONTRIBUTION
  CONSISTENCY_BONUS
  ADJUSTMENT
  REVERSAL
}

enum SnapshotCause {
  VERIFICATION
  RECALCULATION
  ADJUSTMENT
}

model User {
  id          String   @id @default(cuid())
  /// Lowercase 0x-prefixed wallet address.
  address     String   @unique
  displayName String?
  role        UserRole @default(CONTRIBUTOR)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions             WalletSession[]
  evidence             Evidence[]            @relation("EvidenceOwner")
  reviewedEvidence     Evidence[]            @relation("EvidenceReviewer")
  stamps               PassportStamp[]       @relation("StampHolder")
  issuedStamps         PassportStamp[]       @relation("StampIssuer")
  reputationEvents     ReputationEvent[]     @relation("ReputationHolder")
  reputationActions    ReputationEvent[]     @relation("ReputationActor")
  snapshots            ReputationSnapshot[]  @relation("SnapshotHolder")
  triggeredSnapshots   ReputationSnapshot[]  @relation("SnapshotTrigger")
  ownedCampaigns       Campaign[]            @relation("CampaignOwner")
  applications         CampaignApplication[] @relation("Applicant")
  reviewedApplications CampaignApplication[] @relation("ApplicationReviewer")
  deliverables         Deliverable[]         @relation("DeliverableCreator")
  deliverableReviews   DeliverableReview[]
}

/// A wallet sign-in (SIWE). The cookie holds a random token; only its SHA-256 hash is stored.
model WalletSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  /// SIWE nonce used for this sign-in. Unique, so a signed message cannot be replayed.
  nonce      String    @unique
  chainId    Int
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Evidence {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation("EvidenceOwner", fields: [userId], references: [id], onDelete: Cascade)
  kind               EvidenceKind
  /// Reputation category ("campaign", "protocol", "content", "research", "code").
  category           String
  verificationMethod VerificationMethod
  status             EvidenceStatus     @default(PENDING)
  title              String
  summary            String
  /// Public pointer to the evidence: a transaction hash, PR URL, document URL, or deliverable id.
  reference          String
  /// Canonical form of the reference. Unique across all users to block duplicate claims.
  dedupeKey          String             @unique
  chainId            Int?
  txHash             String?
  /// Supported application id (on-chain evidence only).
  appId              String?
  /// When the activity happened (block time for on-chain evidence).
  occurredAt         DateTime
  /// Short reason shown to the contributor and the public.
  statusReason       String?
  /// What the verifier checked (block number, app id, event name, reviewer decision...). Public.
  verificationData   Json?
  /// Reviewer-only note. Never returned by public APIs.
  reviewerNote       String?
  reviewerId         String?
  reviewer           User?              @relation("EvidenceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  stamps           PassportStamp[]
  reputationEvents ReputationEvent[]

  @@index([userId, status])
  @@index([category, status])
  @@index([status, createdAt])
  @@index([kind, status])
}

model PassportStamp {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation("StampHolder", fields: [userId], references: [id], onDelete: Cascade)
  category   StampCategory
  /// The verified evidence that earned this stamp.
  evidenceId String
  evidence   Evidence      @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  issuedAt   DateTime      @default(now())
  /// Reviewer or admin who triggered issuance. Null when issued automatically after on-chain verification.
  issuedById String?
  issuedBy   User?         @relation("StampIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([userId, category])
  @@unique([evidenceId, category])
  @@index([userId, issuedAt])
}

model ReputationEvent {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation("ReputationHolder", fields: [userId], references: [id], onDelete: Cascade)
  kind               ReputationEventKind
  /// Points awarded (negative for reversals and downward corrections). Always computed on the server.
  points             Int
  /// Score category, e.g. "code", "consistency", "adjustment". Matches the public breakdown.
  category           String
  /// Human-readable explanation shown in the public score history.
  reason             String
  /// Logical key from the rules engine (e.g. "contribution:<evidenceId>"). Null for adjustments and reversals.
  planKey            String?
  /// Physical idempotency key. Unique, so the same event can never be written twice.
  dedupeKey          String              @unique
  /// Version of the scoring rules that produced this event.
  calculationVersion String
  evidenceId         String?
  evidence           Evidence?           @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  /// Day ("2026-10-09") or ISO week ("2026-W41") the event counts toward.
  periodKey          String?
  /// For reversals: the event being reversed. Unique, so an event is reversed at most once.
  reversesEventId    String?             @unique
  reverses           ReputationEvent?    @relation("Reversal", fields: [reversesEventId], references: [id], onDelete: Restrict)
  reversedBy         ReputationEvent?    @relation("Reversal")
  /// Who made an adjustment or triggered a recalculation. Null for automatic events.
  actorId            String?
  actor              User?               @relation("ReputationActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([userId, category])
  @@index([planKey])
}

/// Score after each change, for history and fast reads. Always derivable from the ledger.
model ReputationSnapshot {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation("SnapshotHolder", fields: [userId], references: [id], onDelete: Cascade)
  total              Int
  /// Points per category at this moment.
  breakdown          Json
  tier               String
  calculationVersion String
  cause              SnapshotCause
  eventCount         Int
  triggeredById      String?
  triggeredBy        User?         @relation("SnapshotTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Collab Board
// ---------------------------------------------------------------------------

enum CampaignCategory {
  ART
  CONTENT
  DEVELOPMENT
  COMMUNITY
  RESEARCH
  VIDEO
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  CLOSED
  COMPLETED
  CANCELLED
}

/// On-chain registration in CampaignPayments. A campaign is shown as registered only after the event is verified.
enum RegistrationStatus {
  NOT_REGISTERED
  PENDING
  CONFIRMED
  FAILED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DeliverableStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

model Campaign {
  id                 String             @id @default(cuid())
  /// The signed-in wallet that created the campaign. Never taken from a request body.
  ownerId            String
  owner              User               @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  projectName        String
  title              String
  summary            String
  description        String
  category           CampaignCategory
  objectives         String[]
  /// What must be delivered.
  deliverables       String[]
  /// Who may apply.
  eligibility        String[]
  /// How the owner decides a deliverable is acceptable.
  acceptanceCriteria String[]
  requiredSkills     String[]
  /// Key of a supported payment token (see src/lib/collabs/tokens.ts).
  paymentToken       String
  /// Amount paid to each accepted creator, in the token's base units.
  amountPerCreator   Decimal            @db.Decimal(78, 0)
  slots              Int
  deadline           DateTime
  status             CampaignStatus     @default(DRAFT)
  publishedAt        DateTime?
  /// bytes32 id used by CampaignPayments.registerCampaign. Unique so a campaign registers once.
  chainCampaignId    String?            @unique
  registrationStatus RegistrationStatus @default(NOT_REGISTERED)
  registrationTxHash String?
  registrationError  String?
  registeredAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  applications CampaignApplication[]
  submissions  Deliverable[]
  payments     CampaignPayment[]

  @@index([status, deadline])
  @@index([category, status])
  @@index([ownerId])
}

model CampaignApplication {
  id             String            @id @default(cuid())
  campaignId     String
  campaign       Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  applicantId    String
  applicant      User              @relation("Applicant", fields: [applicantId], references: [id], onDelete: Cascade)
  proposal       String
  /// Ids of the applicant's own verified Passport evidence, checked on the server.
  evidenceIds    String[]
  status         ApplicationStatus @default(PENDING)
  decisionReason String?
  reviewedById   String?
  reviewedBy     User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  deliverables Deliverable[]

  /// One application per creator per campaign.
  @@unique([campaignId, applicantId])
  @@index([campaignId, status])
  @@index([applicantId])
}

model Deliverable {
  id            String              @id @default(cuid())
  campaignId    String
  campaign      Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  applicationId String
  application   CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       User                @relation("DeliverableCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  /// https link to the submitted work.
  contentUrl    String
  /// 0x-prefixed SHA-256 of the submitted content, so the reviewed content can be identified later.
  contentHash   String
  notes         String?
  /// 1 for the first submission, 2 after a rejection and resubmission, ...
  revision      Int
  status        DeliverableStatus   @default(SUBMITTED)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  reviews DeliverableReview[]
  payment CampaignPayment?

  /// The same content cannot be submitted twice for one application.
  @@unique([applicationId, contentHash])
  @@unique([applicationId, revision])
  @@index([campaignId, status])
}

/// Append-only review history for deliverables.
model DeliverableReview {
  id            String            @id @default(cuid())
  deliverableId String
  deliverable   Deliverable       @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User              @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  decision      DeliverableStatus
  reason        String
  createdAt     DateTime          @default(now())

  @@index([deliverableId, createdAt])
}

// ---------------------------------------------------------------------------
// Payments (CampaignPayments contract)
// ---------------------------------------------------------------------------

/// AWAITING_TRANSACTION: intent prepared, no verified transaction yet.
/// PENDING_CONFIRMATION: matching CreatorPaid event found, waiting for confirmations.
/// CONFIRMED: event verified and confirmed. Only this status counts as paid.
/// FAILED: the hinted transaction reverted or was not a valid payment; a new attempt is allowed.
/// MISMATCH: a CreatorPaid event for this deliverable had the wrong recipient, token, amount, or payer.
enum PaymentStatus {
  AWAITING_TRANSACTION
  PENDING_CONFIRMATION
  CONFIRMED
  FAILED
  MISMATCH
}

/// The expected payment for one accepted deliverable, and its verified on-chain proof.
model CampaignPayment {
  id              String        @id @default(cuid())
  campaignId      String
  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  /// One payment per accepted deliverable.
  deliverableId   String        @unique
  deliverable     Deliverable   @relation(fields: [deliverableId], references: [id], onDelete: Restrict)
  chainId         Int
  contractAddress String
  chainCampaignId String
  /// Zero address for native MON.
  tokenAddress    String
  tokenKey        String
  /// Expected amount in base units.
  amount          Decimal       @db.Decimal(78, 0)
  creatorAddress  String
  payerAddress    String
  deliverableRef  String
  status          PaymentStatus @default(AWAITING_TRANSACTION)
  /// Transaction hash reported by the browser. A hint only, never proof.
  submittedTxHash String?
  /// Verified on-chain proof (set from the CreatorPaid log).
  txHash          String?
  logIndex        Int?
  blockNumber     BigInt?
  blockHash       String?
  failureReason   String?
  confirmedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  /// A single on-chain log can prove at most one payment.
  @@unique([txHash, logIndex])
  @@index([status])
  @@index([chainCampaignId, deliverableRef])
}

/// Raw contract events seen by the indexer. Unique per log, so re-indexing is harmless.
model ChainEvent {
  id              String   @id @default(cuid())
  chainId         Int
  contractAddress String
  eventName       String
  txHash          String
  logIndex        Int
  blockNumber     BigInt
  blockHash       String
  /// Decoded event arguments (bigints as strings).
  args            Json
  /// What the indexer did with it, e.g. "confirmed-payment", "mismatch", "unmatched".
  outcome         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([chainId, txHash, logIndex])
  @@index([eventName, blockNumber])
}

/// Last block the indexer fully processed, per contract.
model IndexerCursor {
  id        String   @id
  lastBlock BigInt
  updatedAt DateTime @updatedAt
}
