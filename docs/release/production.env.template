# Chog World Order: production environment template.
# Every value below is a PLACEHOLDER. Replace each one in your hosting
# provider's secret store (e.g. Vercel Project Settings > Environment Variables,
# scope "Production"). Never commit a filled-in copy of this file.
# NEXT_PUBLIC_* values are compiled into the browser bundle: changing them
# requires a new build/deployment, and they must never contain secrets.

# --- Core ---------------------------------------------------------------------
# Exact public origin (scheme + host, no path). Used as the SIWE domain/URI and
# to reject cross-site writes. Must match the URL users load.
APP_ORIGIN=https://app.example.com

# 32+ random characters. Generate: openssl rand -hex 32
# Rotating it invalidates in-flight sign-in nonces (not existing sessions).
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARS_FROM_openssl_rand_hex_32

# PostgreSQL. Use the provider's POOLED connection string for the app
# (serverless), with TLS. Run migrations with the DIRECT (non-pooled) URL.
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@POOLER_HOST:6543/chog?sslmode=require

# --- Monad --------------------------------------------------------------------
# Server-side RPC used for every on-chain verification. Prefer a dedicated
# provider endpoint (higher rate and eth_getLogs limits) over the public RPC.
# Public endpoint (rate-limited): https://rpc.monad.xyz
MONAD_RPC_URL=https://MONAD_MAINNET_RPC_PROVIDER_URL

# --- CampaignPayments (leave EMPTY until the contract is deployed, verified,
# and the post-deployment checklist passes; empty = on-chain payments off) ------
NEXT_PUBLIC_CAMPAIGN_PAYMENTS_ADDRESS=
# Block number of the deployment transaction (from its receipt).
CAMPAIGN_PAYMENTS_DEPLOY_BLOCK=
# Blocks of depth required in addition to Monad finality. Default 2.
PAYMENT_CONFIRMATIONS=2
# Kill switch: "true" stops new registration/payment instructions.
PAYMENTS_PAUSED=false

# Optional: Monad USDC (official address from Circle's documentation only).
# Leave empty for MON-only. Must also be enabled on-chain via setSupportedToken.
NEXT_PUBLIC_USDC_ADDRESS=

# --- Indexer and operations ---------------------------------------------------
# 32+ random characters. Bearer token for /api/indexer/run and /api/indexer/status.
CRON_SECRET=REPLACE_WITH_64_HEX_CHARS_FROM_openssl_rand_hex_32
# 100 for the Monad Foundation public RPC; raise only to your provider's limit.
INDEXER_MAX_BLOCK_RANGE=100
# getLogs calls per run. Keep one run well under your function time limit.
INDEXER_MAX_CHUNKS_PER_RUN=50
# Blocks behind the cursor re-scanned each run (500 blocks is about 3.3 minutes on Monad).
INDEXER_RECONCILE_BLOCKS=500
# Optional https webhook for alerts (Slack/Discord/PagerDuty-compatible JSON).
ALERT_WEBHOOK_URL=

# --- Deployment-time only (operator machine; NOT app env vars) -----------------
# CAMPAIGN_PAYMENTS_ADMIN=0xMULTISIG_ADDRESS_ON_MONAD   # contract owner
# DEPLOY_TX_HASH=0xDEPLOYMENT_TRANSACTION_HASH          # for verify-deployment
