# Copy to .env.local (Next.js) and .env (Prisma CLI). Never commit real values.

# PostgreSQL connection string. Without it, the Passport API answers
# 503 "passport service not configured" and the UI shows sample data only.
DATABASE_URL=

# Public origin of this app, used for Sign-In with Ethereum (domain + URI)
# and for rejecting cross-site write requests. Example: http://localhost:3000
APP_ORIGIN=

# Random secret, at least 32 characters, used to sign the sign-in nonce cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Monad mainnet RPC endpoint used to verify on-chain evidence server-side.
# Without it, on-chain claims are stored with status UNAVAILABLE.
MONAD_RPC_URL=
