# Copy to .env.local (Next.js) and .env (Prisma CLI). Never commit real values.

# PostgreSQL connection string. Without it, the Passport API answers
# 503 "passport service not configured" and the UI shows sample data only.
DATABASE_URL=

# Public origin of this app, used for Sign-In with Ethereum (domain + URI)
# and for rejecting cross-site write requests. Example: http://localhost:3000
APP_ORIGIN=

# Random secret, at least 32 characters, used to sign the sign-in nonce cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Monad mainnet RPC endpoint used to verify on-chain evidence server-side.
# Without it, on-chain claims are stored with status UNAVAILABLE.
MONAD_RPC_URL=

# Deployed CampaignPayments contract on Monad. Empty: campaigns publish
# off-chain and payment endpoints answer 503 payments_not_configured.
NEXT_PUBLIC_CAMPAIGN_PAYMENTS_ADDRESS=

# Block the contract was deployed in; the payment indexer starts there.
CAMPAIGN_PAYMENTS_DEPLOY_BLOCK=

# Confirmations required before a registration or payment counts. Default 2.
PAYMENT_CONFIRMATIONS=

# Random secret, at least 32 characters, for the indexer endpoint
# (Authorization: Bearer <CRON_SECRET> on /api/indexer/run).
CRON_SECRET=

# Monad USDC token address. Empty: only MON budgets are offered. The token
# must also be allowed in the contract with setSupportedToken.
NEXT_PUBLIC_USDC_ADDRESS=
